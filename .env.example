# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
# только для REST API /api/v1 (service role, НИКОГДА не пушить)
SUPABASE_SECRET_KEY=eyJ...

# Автоматические миграции (npm run db:migrate / db:seed)
# Dashboard → Connect → Session pooler (порт 5432), [YOUR-PASSWORD]
# заменить на пароль БД (Settings → Database). НЕ пушить — в .gitignore.
DATABASE_URL=postgresql://postgres.xxxx:ПАРОЛЬ@aws-0-region.pooler.supabase.com:5432/postgres

# Эмбеддинги умной ленты (опционально): Ollama локально
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=bge-m3
# или OpenAI-совместимый API
# EMBED_API_KEY=sk-...
# EMBED_API_URL=https://api.openai.com/v1
# EMBED_MODEL=text-embedding-3-small

# MCP-сервер: аккаунт организатора (RLS пропускает его события)
MCP_ORG_EMAIL=organizer@example.com
MCP_ORG_PASSWORD=...

# Бэкфилл эмбеддингов (та же учётка)
SEED_EMAIL=organizer@example.com
SEED_PASSWORD=...
